# ============================================================
# REQUIRED: At least one of these must be configured
# ============================================================

# --- Cloud LLM (Claude) ---
LLM_PROVIDER=claude
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20240620

# --- Local LLM (Ollama) ---
# If CLAUDE_API_KEY is missing, it seamlessly falls back to Ollama
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ============================================================
# DATABASE
# ============================================================
# For Docker Compose, this is automatically overridden to the postgres container
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny

# ============================================================
# OPTIONAL: Tuning parameters
# ============================================================
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
LOG_LEVEL=INFO
