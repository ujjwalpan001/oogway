# ============================================================
# REQUIRED: At least one of these must be configured
# ============================================================

# --- Cloud LLM (Groq) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# --- Local LLM (Ollama) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ============================================================
# DATABASE
# ============================================================
# For Docker Compose, this is automatically overridden to the postgres container
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny

# ============================================================
# OPTIONAL: Tuning parameters
# ============================================================
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
LOG_LEVEL=INFO
